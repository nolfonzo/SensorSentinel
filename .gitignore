.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.DS_Store
.specstory/history/

# Docker secrets and runtime data
docker/.env
docker/postgres/data/
docker/nocodb/data/
docker/mosquitto/data/
docker/mosquitto/log/
docker/nodered/data/node_modules/
docker/nodered/data/.config.*
docker/nodered/data/flows_cred.json
docker/nodered/data/.flows*.backup
docker/nodered/data/package-lock.json
# settings.js is tracked on purpose: it holds deliberate configuration
# (contextStorage, functionExternalModules) whose loss breaks things
# silently. It contains no secrets - keep it that way; if a
# credentialSecret is ever added, move it to an env var.
docker/nodered/data/lib/

# Runtime data volumes (not config)
docker/grafana/data/
docker/nocodb/data/
docker/postgres/data/
docker/mosquitto/data/
docker/mosquitto/log/
docker/nodered/data/.npm/

# Timestamped backups taken before editing configs/flows in place
*.bak
*.bak-*

# Gmail OAuth material used by the Node-RED mail helpers. These are live
# credentials and must never be committed.
docker/nodered/data/credentials.json
docker/nodered/data/token.json

# Node-RED writes runtime state (including credentials) back into these on
# every editor deploy - which is how an app password ended up in a public
# commit on 2026-08-17.
docker/nodered/data/flows_cred.json
docker/nodered/data/.sessions.json
docker/nodered/data/*.bak-*

# Node-RED runtime state: per-pin alert state, rewritten constantly
docker/nodered/data/context/
