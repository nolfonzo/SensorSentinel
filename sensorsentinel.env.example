# SensorSentinel deployment settings.
#
# Copy to sensorsentinel.env (which is gitignored) and fill in. Every script
# in this repo sources it, so the day-to-day commands take no arguments:
#
#   bench:  ./provision-pair.sh
#   jetty:  ./gateway/provision-gateway.sh --wifi-ssid "…" --wifi-pass "…"
#
# Anything here can still be overridden on the command line.

# ── addresses that never change ─────────────────────────────────────────────
# The gateway is always 192.168.8.1 on its own access point, on every unit.
# Joining that AP is how you reach it at a site, so this is the sane default.
GATEWAY_HOST="192.168.8.1"

# The Pi takes this static address on the gateway's network. It has to be
# predictable because the gateway can only be given an IP for its broker,
# never a hostname.
MQTT_HOST="192.168.8.2"

# The home broker the Pi bridges up to, over Tailscale.
UPLINK_HOST="100.114.240.29"

# ── credentials ─────────────────────────────────────────────────────────────
# The broker on the *Pi*, which the gateway publishes to. Not the home broker.
MQTT_USER="heltec-jetty"
MQTT_PASS=""

# The Pi's sudo password, as set in Raspberry Pi Imager.
PI_SUDO_PASS=""

# The gateway's SSH password as it is NOW - the vendor default on a fresh unit.
# Only used for first contact; provisioning installs your key straight away.
GW_SSH_PASS="heltec.org"

# What the gateway's root password is changed TO. The vendor default is
# published in Heltec's documentation, and the unit also runs telnet, so
# leaving it is an open door at any site. Provisioning rotates it and turns
# telnet off.
GW_ROOT_PASS=""

# The password for the gateway's OWN access point - the network you join at a
# site to configure it. Set it here and every pair uses the same one, so there
# is nothing to write down after provisioning. Leave blank and a unique random
# one is generated per pair instead, which isolates units from each other but
# means recording each.
#
# Either way it replaces the vendor default 'heltec.org', which is published in
# Heltec's docs and would otherwise be an open door at every jetty.
AP_PASS=""

# ── Tailscale ───────────────────────────────────────────────────────────────
# A reusable auth key makes provisioning fully non-interactive - without one,
# each Pi needs someone to click a URL in a browser.
#
# Generate at: https://login.tailscale.com/admin/settings/keys
#   - Reusable: yes (so it does one key for the whole fleet)
#   - Ephemeral: NO (these devices should persist)
#   - Tags: optional, but a tag disables key expiry, which otherwise drops the
#     device off the tailnet after ~180 days - a silent failure at a jetty.
TS_AUTHKEY=""

# ── the bench ───────────────────────────────────────────────────────────────
# Your own WiFi. A gateway is pointed at this while it is being built, so that
# it and the Pi are on one network and can be provisioned together.
#   ./gateway/provision-gateway.sh --bench
BENCH_SSID=""
BENCH_PASS=""

# ── optional: the site's WiFi, if known in advance ──────────────────────────
# Fill these in and the jetty visit becomes "plug in and check".
SITE_SSID=""
SITE_PASS=""
