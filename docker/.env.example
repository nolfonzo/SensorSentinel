# SensorSentinel server stack. Copy to .env and fill in - .env is gitignored.
#
#   cp docker/.env.example docker/.env && $EDITOR docker/.env
#
# Every value here is also kept in the secrets store on the LXD, so this file
# can be reconstructed if the Pi is lost.

# ── database ────────────────────────────────────────────────────────────────
DB_PASSWORD=

# ── notification email ──────────────────────────────────────────────────────
# The account alerts are sent FROM. With Gmail this needs 2-Step Verification
# turned on and an *app password* - your normal password will not work.
NOTIFY_EMAIL_USER=
NOTIFY_EMAIL_PASS=
# Only needed if you move off Gmail.
NOTIFY_SMTP_HOST=smtp.gmail.com

# ── Telegram bot (optional) ─────────────────────────────────────────────────
# Create the bot by messaging @BotFather: /newbot, pick a name, and it hands
# you a token. Leave blank and the bot simply idles - email keeps working and
# nothing else changes.
#
# This is the ONLY Telegram value that belongs here. Chat IDs are held in the
# database and users pair themselves through a link in their own email, so
# adding a person never means editing this file or restarting anything.
TELEGRAM_BOT_TOKEN=

# ── NocoDB / Grafana ────────────────────────────────────────────────────────
NOCODB_ADMIN_EMAIL=
NOCODB_ADMIN_PASSWORD=
GRAFANA_PASSWORD=

# ── misc ────────────────────────────────────────────────────────────────────
# Used for timestamps shown to people, in Telegram replies and digests.
TZ=Australia/Sydney
